.wrap {
  padding: 32rpx;
}

.list {
  display: flex;
  flex-direction: column;
}

.item + .item { margin-top: 16rpx; }

.item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #FFFFFF;
  border: 1rpx solid #E5E7EB;
  border-radius: 16rpx;
  padding: 24rpx;
}

.item__tag {
  font-size: 28rpx;
  font-family: ui-monospace, Menlo, monospace;
  color: #344054;
}

.item__time {
  font-size: 24rpx;
  color: #6B7280;
}
