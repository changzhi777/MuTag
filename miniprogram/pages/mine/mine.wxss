.wrap {
  padding: 32rpx;
}

.list {
  display: flex;
  flex-direction: column;
}

.item + .item { margin-top: 16rpx; }

.item {
  background: #FFFFFF;
  border: 1rpx solid #E5E7EB;
  border-radius: 16rpx;
  padding: 24rpx;
}

.item__head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.item__type {
  font-size: 28rpx;
  font-weight: 600;
  color: #0F766E;
}

.item__time {
  font-size: 24rpx;
  color: #6B7280;
}

.item__note {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #344054;
}
