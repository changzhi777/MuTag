/* pages/scan —— 设计 token 与 H5 同源（青沐青 + 冷灰阶），rpx 换算 */
.wrap {
  min-height: 100vh;
  padding: 48rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #F5F7FA;
}

.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 64rpx 0 48rpx;
}

.hero__icon {
  position: relative;
  width: 144rpx;
  height: 144rpx;
}

.hero__corner {
  position: absolute;
  width: 44rpx;
  height: 44rpx;
  border: 6rpx solid #0D9488;
}

.hero__corner--tl { left: 0; top: 0; border-right: none; border-bottom: none; border-radius: 8rpx 0 0 0; }
.hero__corner--tr { right: 0; top: 0; border-left: none; border-bottom: none; border-radius: 0 8rpx 0 0; }
.hero__corner--bl { left: 0; bottom: 0; border-right: none; border-top: none; border-radius: 0 0 0 8rpx; }

.hero__line {
  position: absolute;
  left: 12rpx;
  right: 12rpx;
  top: 50%;
  height: 6rpx;
  border-radius: 3rpx;
  background: #0D9488;
  opacity: 0.35;
}

.hero__title {
  margin-top: 32rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: #1F2937;
}

.hero__sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #6B7280;
}

.scan-btn {
  margin-top: 24rpx;
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 24rpx;
  background: #0D9488;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
}

.scan-btn::after { border: none; }

.pressed { opacity: 0.85; }

.manual {
  margin-top: 48rpx;
  background: #FFFFFF;
  border: 1rpx solid #E5E7EB;
  border-radius: 24rpx;
  padding: 32rpx;
}

.manual__title {
  font-size: 28rpx;
  font-weight: 600;
  color: #344054;
  margin-bottom: 24rpx;
}

.manual__row {
  display: flex;
  gap: 16rpx;
}

.manual__input {
  flex: 1;
  height: 80rpx;
  padding: 0 24rpx;
  border: 2rpx solid #D0D5DD;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
}

.manual__go {
  flex-shrink: 0;
  width: 160rpx;
  height: 88rpx;
  line-height: 88rpx;
  margin: 0;
  padding: 0;
  border-radius: 16rpx;
  background: #ECFDF3;
  color: #067647;
  font-size: 28rpx;
  font-weight: 600;
}

.manual__go::after { border: none; }
.manual__go--disabled { opacity: 0.5; }

.manual__error {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #B54708;
}

.entries {
  display: flex;
  gap: 16rpx;
  margin-top: 48rpx;
}

.entry {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  background: #FFFFFF;
  border: 1rpx solid #E5E7EB;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #0F766E;
  font-weight: 600;
}
