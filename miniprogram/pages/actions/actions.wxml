<view class="wrap">
  <view class="tag-code">{{tagID}}</view>

  <block wx:if="{{!done}}">
    <view class="acts">
      <view
        wx:for="{{actions}}"
        wx:key="key"
        class="act {{current === item.key ? 'act--on' : ''}}"
        data-key="{{item.key}}"
        bindtap="onPick"
      >
        <view class="act__label">{{item.label}}</view>
        <view class="act__hint">{{item.hint}}</view>
      </view>
    </view>

    <view wx:if="{{current === 'transfer'}}" class="field">
      <input class="field__input" placeholder="新位置（如：A栋3层-301）" value="{{location}}" bindinput="onLocation" />
    </view>
    <view class="field">
      <input class="field__input" placeholder="备注（可选）" value="{{note}}" bindinput="onNote" />
    </view>

    <button class="submit" hover-class="pressed" loading="{{submitting}}" bindtap="onSubmit">提交</button>
  </block>

  <block wx:else>
    <view class="done">
      <view class="done__title">操作成功</view>
      <view class="done__sub">已记入资产履历</view>
      <button class="done__btn" hover-class="pressed" bindtap="backToDetail">返回详情</button>
    </view>
  </block>
</view>
