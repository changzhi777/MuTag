/* pages/actions —— token 与全局同源 */
.wrap {
  min-height: 100vh;
  padding: 32rpx;
  box-sizing: border-box;
  background: #F5F7FA;
}

.tag-code {
  padding: 16rpx 24rpx;
  background: #F9FAFB;
  border: 2rpx dashed #D0D5DD;
  border-radius: 16rpx;
  font-size: 30rpx;
  letter-spacing: 2rpx;
  color: #344054;
  font-family: ui-monospace, Menlo, monospace;
  margin-bottom: 32rpx;
}

.acts {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.act {
  width: calc(50% - 8rpx);
  background: #FFFFFF;
  border: 2rpx solid #E5E7EB;
  border-radius: 16rpx;
  padding: 24rpx;
}

.act--on {
  border-color: #0D9488;
  background: #F0FDFA;
}

.act__label {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2937;
}

.act__hint {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #6B7280;
}

.field {
  margin-bottom: 24rpx;
}

.field__input {
  height: 88rpx;
  padding: 0 24rpx;
  background: #FFFFFF;
  border: 2rpx solid #D0D5DD;
  border-radius: 16rpx;
  font-size: 28rpx;
}

.submit {
  margin-top: 16rpx;
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 24rpx;
  background: #0D9488;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
}

.submit::after { border: none; }
.pressed { opacity: 0.85; }

.done {
  text-align: center;
  padding: 96rpx 0;
}

.done__title {
  font-size: 36rpx;
  font-weight: 600;
  color: #067647;
}

.done__sub {
  margin: 16rpx 0 48rpx;
  font-size: 26rpx;
  color: #6B7280;
}

.done__btn {
  display: inline-block;
  width: 320rpx;
  height: 80rpx;
  line-height: 80rpx;
  margin: 0;
  border-radius: 16rpx;
  background: #0D9488;
  color: #FFFFFF;
  font-size: 28rpx;
}

.done__btn::after { border: none; }
